{
  "name": "r-type-lua-engine-epitech",
  "displayName": "R-Type lua engine epitech",
  "description": "Install the R-Type engine and create, open and run Lua games from VS Code.",
  "version": "0.0.3",
  "publisher": "ariel-amriou",
  "license": "MIT",
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArielAmriou/r-type-lua-engine-epitech"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "r-type-lua-engine-epitech.installEngine",
        "title": "Install engine"
      },
      {
        "command": "r-type-lua-engine-epitech.updateEngine",
        "title": "Update engine"
      },
      {
        "command": "r-type-lua-engine-epitech.createProject",
        "title": "Create lua project"
      },
      {
        "command": "r-type-lua-engine-epitech.openProject",
        "title": "Open lua project"
      },
      {
        "command": "r-type-lua-engine-epitech.openDoc",
        "title": "Open Lua scripting guide"
      },
      {
        "command": "r-type-lua-engine-epitech.toggleDebug",
        "title": "Enable/disable debug mode"
      },
      {
        "command": "r-type-lua-engine-epitech.runGame",
        "title": "Run lua game",
        "icon": {
          "light": "icons/launch-light.svg",
          "dark": "icons/launch-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "r-type-lua-engine-epitech.runGame",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "luaEngine",
          "title": "Lua Engine",
          "icon": "icons/sidebar.svg"
        }
      ]
    },
    "views": {
      "luaEngine": [
        {
          "id": "luaEngine.actions",
          "name": "Actions",
          "icon": "icons/sidebar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "luaEngine.actions",
        "contents": "Make Lua games with the R-Type engine.\n\nEngine\n[Install engine](command:r-type-lua-engine-epitech.installEngine)\n[Update engine](command:r-type-lua-engine-epitech.updateEngine)\nProjects\n[Create project](command:r-type-lua-engine-epitech.createProject)\n[Open project](command:r-type-lua-engine-epitech.openProject)\n[Run game](command:r-type-lua-engine-epitech.runGame)\n[Enable/disable debug mode](command:r-type-lua-engine-epitech.toggleDebug)\nHelp\n[Lua scripting guide](command:r-type-lua-engine-epitech.openDoc)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
